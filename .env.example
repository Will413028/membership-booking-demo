# Supabase project URL exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous key exposed to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase server-only service role key for webhooks and explicit admin work.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe test-mode server-only API key.
STRIPE_SECRET_KEY=
# Stripe test-mode webhook signing secret from Stripe CLI or dashboard.
STRIPE_WEBHOOK_SECRET=
# Canonical site URL used to build Stripe return URLs.
NEXT_PUBLIC_SITE_URL=
# Optional direct database connection for local tooling; never commit credentials.
SUPABASE_DB_URL=
# Set to true only to run E2E against a disposable Supabase project.
E2E_SEED=
# Explicit database-reset command accepted by the E2E setup.
E2E_RESET_COMMAND=
# Must be true to acknowledge that the E2E project can be reset.
E2E_DISPOSABLE_SUPABASE=
# Seeded member email used only by the local E2E suite.
E2E_MEMBER_EMAIL=
# Seeded member password used only by the local E2E suite.
E2E_MEMBER_PASSWORD=
# Seeded admin email used only by the local E2E suite.
E2E_ADMIN_EMAIL=
# Seeded admin password used only by the local E2E suite.
E2E_ADMIN_PASSWORD=
# Optional local-only Playwright app URL; must use HTTP localhost/127.0.0.1/::1 on port 3000.
E2E_BASE_URL=
